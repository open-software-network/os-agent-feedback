# The web image builds from the repository root because pnpm needs the root
# workspace manifests and lockfile. Send only that dependency metadata and web.
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!web/
!web/**

# Production example images also build from the repository root so npm can
# install the exact SDK tarball committed with the source.
!backend/
backend/*
!backend/public/
backend/public/*
!backend/public/agent-feedback-node-*.tgz
!examples/
examples/*
!examples/node-express/
examples/node-express/*
!examples/node-express/Dockerfile
!examples/node-express/package.json
!examples/node-express/package-lock.json
!examples/node-express/src/
!examples/node-express/src/**
!examples/node-mcp/
examples/node-mcp/*
!examples/node-mcp/Dockerfile
!examples/node-mcp/package.json
!examples/node-mcp/package-lock.json
!examples/node-mcp/src/
!examples/node-mcp/src/**

# Never let local dependency/build state back into the root build context.
.git
**/node_modules
**/.next
backend/target
**/target

# `!web/**` above would otherwise re-include a developer's local env files and
# bake them into the build context and BuildKit cache. CI checkouts are clean,
# but a local `docker build` would not be.
**/.env
**/.env.*
