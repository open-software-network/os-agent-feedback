{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-software-network/os-epode.git"
  },
  "scripts": {
    "check": "biome check .",
    "check:fix": "biome check --fix .",
    "test": "node --test tests/*.test.mjs",
    "seed:dashboard-demo": "cd backend && cargo run --bin seed_dashboard_demo -- seed",
    "seed:dashboard-demo:status": "cd backend && cargo run --bin seed_dashboard_demo -- status",
    "seed:dashboard-demo:reset": "cd backend && cargo run --bin seed_dashboard_demo -- reset",
    "build:artifacts": "bash tests/build-hosted-artifacts.sh",
    "gen:types": "mkdir -p web/lib/api && pnpm exec openapi-typescript backend/openapi.json -o web/lib/api/types.ts",
    "test:setup-matrix": "node tests/setup-matrix-e2e.mjs",
    "test:icp-loop": "node tests/icp-onboarding-e2e.mjs",
    "test:customer-enrichment-e2e": "node tests/customer-enrichment-e2e.mjs",
    "test:customer-context-mcp-e2e": "node tests/customer-context-mcp-e2e.mjs",
    "test:customer-context-scenarios": "node --test tests/customer-context-scenario-matrix.test.mjs",
    "test:agent-compliance": "node experiments/agent-compliance/run.mjs --runtime codex --suite placement-pilot --repetitions 3 --output .artifacts/agent-compliance/codex-placement.json",
    "test:agent-compliance:codex-ask-once": "node experiments/agent-compliance/codex-ask-once-matrix.mjs --cases smoke",
    "test:agent-compliance:codex-ask-once:all": "node experiments/agent-compliance/codex-ask-once-matrix.mjs --cases all",
    "test:agent-compliance:claude-zero-install": "node experiments/agent-compliance/claude-zero-install-matrix.mjs",
    "test:agent-compliance:durable": "node experiments/agent-compliance/durable-helper-trial.mjs --runtimes codex,claude --scenarios two_phase_native_preference --repetitions 1",
    "test:agent-compliance:answer-first-copy": "node experiments/agent-compliance/zero-install-answer-first-copy.mjs --runtimes codex,claude --repetitions 1",
    "test:agent-compliance:native-rules": "node experiments/agent-compliance/native-project-rules-trial.mjs --runtimes codex,claude --variants server_exact,no_bootstrap_server_exact --repetitions 1",
    "test:agent-compliance:http-discovery": "node experiments/agent-compliance/http-standard-discovery-trial.mjs --runtimes codex,claude --repetitions 1",
    "test:agent-compliance:local-sdk": "node experiments/agent-compliance/local-sdk-answer-first-e2e.mjs --runtimes codex,claude",
    "test:agent-harness-inventory": "node experiments/agent-compliance/runtime-inventory.mjs",
    "test:agent-compliance:companion": "node experiments/agent-compliance/companion-production-run.mjs",
    "test:agent-compliance:production": "node experiments/agent-compliance/production-run.mjs",
    "test:industries:production": "node experiments/agent-compliance/industry-production-e2e.mjs",
    "analyze:agent-compliance": "node experiments/agent-compliance/analyze.mjs .artifacts/agent-compliance/*.json",
    "docs:validate": "cd docs && pnpm exec mint validate",
    "docs:a11y": "cd docs && pnpm exec mint a11y",
    "test:docs-loop": "pnpm run docs:validate && pnpm run docs:a11y && node --test tests/docs-contract.test.mjs && SETUP_MATRIX_BACKEND_URL=https://agent-feedback-api-v2-canary.up.railway.app SETUP_MATRIX_DB_ENVIRONMENT=v2-canary SETUP_MATRIX_SKIP_BUILD=true node tests/setup-matrix-e2e.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "mint": "4.2.734",
    "openapi-typescript": "7.13.0"
  },
  "name": "os-epode",
  "version": "1.0.0",
  "description": "Epode learns permissioned customer context through customer agents, then helps companies personalize and measure the experience.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/open-software-network/os-epode/issues"
  },
  "homepage": "https://github.com/open-software-network/os-epode#readme"
}
