DATABASE_URL=postgres://postgres:postgres@localhost:54329/agent_feedback
DATABASE_MAX_CONNECTIONS=10
EPODE_IDENTITY_HMAC_SECRET=replace-with-at-least-32-random-bytes
PUBLIC_BASE_URL=http://localhost:8080
WEB_APP_URL=http://localhost:3000
OS_ACCOUNTS_URL=https://accounts.opensoftware.co
OS_ACCOUNTS_API_URL=https://accounts-api.opensoftware.co
OS_ACCOUNTS_CLIENT_ID=ocl_your_registered_client_id
PORT=8080
RUST_LOG=agent_feedback=info,tower_http=info

# Optional local-only OS Accounts identity bypass. The same DEV_AUTH_ENABLED
# value must be set for the Next.js process. Keep the signing key local.
# APP_ENV=development
# DEV_AUTH_ENABLED=true
# DEV_AUTH_SIGNING_KEY=<base64url-no-pad encoding of exactly 32 random bytes>

# Production only: set temporarily to exactly one reviewed future additive
# migration while this binary is serving as the migration bridge.
# EPODE_MIGRATION_BRIDGE_MAX_VERSION=33
