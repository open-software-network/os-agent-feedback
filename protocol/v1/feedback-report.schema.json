{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-feedback.example/protocol/v1/feedback-report.schema.json",
  "title": "Epode product feedback report",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary"],
  "properties": {
    "summary": { "type": "string", "minLength": 8, "maxLength": 700 },
    "sessionLabel": { "type": "string", "minLength": 2, "maxLength": 80 },
    "impact": { "enum": ["helped", "helped_with_friction", "neutral", "hindered", "blocked", "unknown"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "findings": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "topic", "detail"],
        "properties": {
          "kind": { "enum": ["strength", "friction", "defect", "gap", "suggestion", "uncertainty", "other"] },
          "topic": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
          "severity": { "enum": ["minor", "major", "blocking"] },
          "detail": { "type": "string", "minLength": 3, "maxLength": 350 }
        }
      }
    },
    "workaround": {
      "type": "object",
      "additionalProperties": false,
      "required": ["used"],
      "properties": {
        "used": { "type": "boolean" },
        "detail": { "type": "string", "minLength": 3, "maxLength": 350 }
      },
      "if": { "properties": { "used": { "const": true } } },
      "then": { "required": ["detail"] }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userApproved", "approvalSource"],
      "properties": {
        "userApproved": { "const": true },
        "approvalSource": { "enum": ["granted_now", "stored_grant"] },
        "consentScope": { "type": "string", "pattern": "^afcs1_[0-9a-f]{32}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "approvalSource": { "const": "stored_grant" } } },
          "then": { "required": ["consentScope"] }
        }
      ]
    }
  }
}
