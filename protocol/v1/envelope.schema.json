{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app.epode.ai/protocol/v1/envelope.schema.json",
  "title": "Epode agent feedback response contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "mode", "state", "requested", "consentRequired", "consentPolicy", "reliability", "when", "instruction", "privacy", "expiresAt"],
  "properties": {
    "v": { "const": 1 },
    "mode": { "enum": ["never_ask", "ask_once", "ask_always"] },
    "configuredMode": { "enum": ["ask_once", "ask_always"] },
    "state": { "enum": ["consent_required", "feedback_ready"] },
    "requested": { "const": true },
    "consentRequired": { "type": "boolean" },
    "consentPolicy": { "enum": ["none", "once", "always"] },
    "consentManagedBy": { "const": "epode" },
    "reliability": { "const": "best_effort_without_agent_adapter" },
    "when": { "enum": ["after_experience_known_before_final_response", "after_experience_known_and_consent_resolved", "after_experience_known_and_explicit_user_approval"] },
    "instruction": { "type": "string", "minLength": 1, "maxLength": 2400 },
    "requiredAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "question", "submitDecision"],
      "properties": {
        "type": { "const": "ask_user" },
        "question": { "type": "string", "minLength": 1, "maxLength": 500 },
        "submitDecision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "method", "authorization", "contentType", "bodySchema"],
          "properties": {
            "url": { "type": "string", "format": "uri", "pattern": "^https://" },
            "method": { "const": "POST" },
            "authorization": { "type": "string", "pattern": "^Bearer afr2_" },
            "contentType": { "const": "application/json" },
            "bodySchema": {
              "type": "object",
              "additionalProperties": false,
              "required": ["decision"],
              "properties": { "decision": { "const": ["approved", "declined"] } }
            }
          }
        }
      }
    },
    "submit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "method", "authorization", "contentType", "reportSchema"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "method": { "const": "POST" },
        "authorization": { "type": "string", "pattern": "^Bearer afr2_" },
        "contentType": { "const": "application/json" },
        "reportSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "optional", "impacts", "findingKinds", "findingSeverities", "confidenceRange", "findingRequired", "findingOptional", "findingTopicFormat", "workaroundRequired", "workaroundOptional", "maxFindings"],
          "properties": {
            "required": { "const": ["summary"] },
            "optional": { "const": ["impact", "confidence", "findings", "workaround"] },
            "impacts": { "const": ["helped", "helped_with_friction", "neutral", "hindered", "blocked", "unknown"] },
            "findingKinds": { "const": ["strength", "friction", "defect", "gap", "suggestion", "uncertainty", "other"] },
            "findingSeverities": { "const": ["minor", "major", "blocking"] },
            "confidenceRange": { "const": [0, 1] },
            "findingRequired": { "const": ["kind", "topic", "detail"] },
            "findingOptional": { "const": ["severity"] },
            "findingTopicFormat": { "const": "lowercase_slug" },
            "workaroundRequired": { "const": ["used"] },
            "workaroundOptional": { "const": ["detail"] },
            "maxFindings": { "const": 8 }
          }
        }
      }
    },
    "privacy": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "expiresAt": { "type": "string", "format": "date-time" }
  },
  "oneOf": [
    {
      "properties": {
        "state": { "const": "consent_required" },
        "mode": { "enum": ["ask_once", "ask_always"] },
        "consentRequired": { "const": true },
        "consentManagedBy": { "const": "epode" }
      },
      "required": ["configuredMode", "consentManagedBy", "requiredAction"],
      "not": { "required": ["submit"] }
    },
    {
      "properties": {
        "state": { "const": "feedback_ready" },
        "mode": { "const": "never_ask" },
        "consentRequired": { "const": false },
        "consentPolicy": { "const": "none" },
        "when": { "const": "after_experience_known_before_final_response" }
      },
      "required": ["submit"],
      "not": { "required": ["requiredAction"] }
    }
  ]
}
