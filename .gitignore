# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies and language build caches
**/node_modules/
.pnpm-store/
**/target/
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.venv/
*.py[cod]

# testing
**/coverage/
.coverage

# misc
.DS_Store
*.pem

# debug and tool output logs
*.log

# env files (can opt-in for committing if needed)
.env*
!**/.env.example

# build output
**/dist/
**/outputs/
**/work/
**/*.tsbuildinfo
web/.next/
web/out/
/.artifacts/
.vinext/
.wrangler/

# agent coordination (shared via symlink from main checkout)
.briefs
.reviews

# tunnel lab local state (never commit cloudflared config or runtime routes)
tunnel/config.yml
tunnel/routes.json
