{
	auto_https off
}

:{$PORT:8080} {
	@app path /app /app/
	redir @app https://app.epode.ai/auth/start 308

	root * /srv

	@static_assets path /styles.css /favicon.svg /og.png
	header @static_assets Cache-Control "public, max-age=3600"

	# HTML must revalidate, or a deploy can sit behind heuristic browser caching
	# for an unpredictable interval. Matches backend/src/main.rs's convention for
	# the dashboard document.
	@html path / /index.html /app/index.html
	header @html Cache-Control "public, max-age=0, must-revalidate"

	# Site-wide. This page has no JavaScript and no forms, so a strict policy is
	# nearly free. Mirrors the header set backend/src/main.rs already applies to
	# every dashboard response.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'self'; script-src 'none'; style-src 'self'; img-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	file_server
}
