# Server-only Rust API origin used by the Next.js BFF.
API_URL=http://localhost:8080
WEB_APP_URL=http://localhost:3000

# Match the backend setting to let the local signed identity cookie through
# Next.js page gating. Rust still verifies the cookie and authorizes every API request.
# DEV_AUTH_ENABLED=true

# Required only while installing the private Central Icon System package.
# Keep the real value in the developer or deployment environment.
CENTRAL_LICENSE_KEY=
